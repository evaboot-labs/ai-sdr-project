      "name": "All leads",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1980,
        -120
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.leads.filter(l => l.id)) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are an SDR. For each lead in the JSON, apply the ICP below: first its hard rules (fail one = drop, with the field and its value), then the fit score from 1 to 3 with a one-line reason that quotes the fields you used.\nFor every lead scored 2 or 3, write a LinkedIn connection note under 200 characters built on one fact from the lead (no pitch, no link), and a one-sentence email opening line built on a different fact. Follow the offer and tone below.\nUse only facts in the JSON and the offer: never invent a customer, a number, a post or a mutual connection.\nReturn {id, drop} for a dropped lead, or {id, fit, reason, connection_note, opening_line}.\n\nICP:\n{{ $('Your settings').first().json.icp }}\n\nOffer and tone:\n{{ $('Your settings').first().json.offer }}",
          "maxIterations": 3
        }
      },
      "id": "99e8a718-485d-4fac-bae4-b4be122aa422",
      "name": "Qualify and write",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        2200,
        -120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
