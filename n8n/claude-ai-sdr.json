    {
      "parameters": {
        "jsCode": "\n// Stop on a failed export, or after 20 minutes, instead of waiting forever.\nconst s = $json.structuredContent?.result?.status;\nif (['FAILED', 'ERROR', 'CANCELLED', 'CANCELED'].includes(s)) throw new Error(`The export ended with status ${s}.`);\nif ($runIndex >= 40) throw new Error('The export is still not finished after 20 minutes.');\nreturn $input.all();\n"
      },
      "id": "5598cb0e-2913-4ffe-81a5-5bc7a92cb77f",
      "name": "Still running?",
      "type": "n8n-nodes-base.code",
