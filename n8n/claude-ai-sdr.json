      "id": "2d18f4ff-9868-4011-9c83-081b07f88aa3",
      "name": "Get the leads",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        1320,
        -120
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "Evaboot MCP (Bearer)"
        }
