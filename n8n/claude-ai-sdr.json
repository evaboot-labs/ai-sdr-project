      "id": "237f10fa-7cc3-4a41-8930-5dce962c34d0",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        2160,
        100
      ],
      "credentials": {
        "anthropicApi": {
