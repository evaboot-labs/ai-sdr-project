      "id": "8f56cac3-d8b7-48e8-a944-9fe7f219b1f2",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        2160,
        100
      ],
      "credentials": {
        "anthropicApi": {
          "id": "",
          "name": "Anthropic"
